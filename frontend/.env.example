# MySQL connection used by the Staffly dashboard's server-side routes.
# Copy to .env.local and adjust. If MySQL is unreachable, the live panels
# degrade gracefully to static mode (everything is still explained from
# database/schemas.sql); nothing here is required to view the dashboard.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=12345
DB_NAME=employee_management
